CL65 = /usr/bin/cl65
WALK_TUNED ?= 1
TIMING_MARKER ?= 0
SHOT_SPEED ?= 4
HIT_MODE ?= 1
SHIELD_STAGE ?= 1
SHIELD_DRAW_RUNS ?= 1
HIT_DRAW_DELTA ?= 1
TEST_FREEZE = 0
TEST_SHOT_X = 255
TEST_AUTO_FIRE = 0
TEST_POSE ?= 0
INTRO_HOLD_FRAMES ?= 30
INTRO_PRE_FRAMES ?= 30
ENEMY_SHOT_STAGE ?= 2
ENEMY_SHOT_SPEED ?= 1
ENEMY_SHOT_PERIOD ?= 90
ENEMY_BULLET_ANIM_TICKS ?= 4
ENEMY_BULLET_COMPACT ?= 1
V44_E_MODE = 3
V45_COLOR_STEP ?= 2
V45_ALIEN_COLOR ?= 1
V45_SHIP_A ?= 1
V45_SHIP_B ?= 1
V45_EXPLOSION_COLOR ?= 1
V45_BREAK_SHIFT_UP ?= 3
V45_OBJECT_COLOR ?= 1
V45_BULLET_COLOR ?= 1
V45_SHIP_HIT_MODE = 3
V45_START_ALIENS ?= 10
V45_STEP_MODE = 0
V45_SHIELD_LOAD_MODE = 3
V45_CONTACT_MODE = 2
V45_BREAK_MODE = 3
V45_CACHE_MODE = 2
V45_RANGE_MODE ?= 2
V45_SOLID_CACHE_MODE ?= 0
# r18 (2026-11-19): SOLID_CACHE_MODE=1 is broken -- the cached row_mask
# in v45_paint_shield_rows loses its low byte across tgi_bar calls, so
# repainted shield rows silently drop every solid run right of the
# first gap (the "shield vanishes ahead of the alien" bug, caught on
# the user's video and reproduced on an emulator). Mode 0 reads the bits
# live via shield_solid() and is exact; keep it 0.
V45_SHIELD_PERF_MODE = $(if $(filter 1 2,$(V45_BREAK_MODE)),0,3)
V45_EDGE_MODE = 2
TARGET = invaders_v45_solid_cache1_integration_count$(V45_START_ALIENS).lnx
all: $(TARGET)
$(TARGET): main.c sndirq.asm sound_data.asm vpdiff_table.asm sprites.h sprites_tuned.h hit_effect_assets.h enemy_bullet_suzy.h enemy_bullet_compact.h ../generated/rom_data.h ../generated/sprites_data.h
	$(CL65) -t lynx -C lynx_snd.cfg -O -DWALK_TUNED=$(WALK_TUNED) -DTIMING_MARKER=$(TIMING_MARKER) -DSHOT_SPEED=$(SHOT_SPEED) -DHIT_MODE=$(HIT_MODE) -DSHIELD_STAGE=$(SHIELD_STAGE) -DSHIELD_DRAW_RUNS=$(SHIELD_DRAW_RUNS) -DHIT_DRAW_DELTA=$(HIT_DRAW_DELTA) -DINTRO_HOLD_FRAMES=$(INTRO_HOLD_FRAMES) -DINTRO_PRE_FRAMES=$(INTRO_PRE_FRAMES) -DENEMY_SHOT_STAGE=$(ENEMY_SHOT_STAGE) -DENEMY_SHOT_SPEED=$(ENEMY_SHOT_SPEED) -DENEMY_SHOT_PERIOD=$(ENEMY_SHOT_PERIOD) -DENEMY_BULLET_ANIM_TICKS=$(ENEMY_BULLET_ANIM_TICKS) -DENEMY_BULLET_COMPACT=$(ENEMY_BULLET_COMPACT) -DV44_E_MODE=$(V44_E_MODE) -DV45_COLOR_STEP=$(V45_COLOR_STEP) -DV45_ALIEN_COLOR=$(V45_ALIEN_COLOR) -DV45_SHIP_A=$(V45_SHIP_A) -DV45_SHIP_B=$(V45_SHIP_B) -DV45_EXPLOSION_COLOR=$(V45_EXPLOSION_COLOR) -DV45_BREAK_SHIFT_UP=$(V45_BREAK_SHIFT_UP) -DV45_OBJECT_COLOR=$(V45_OBJECT_COLOR) -DV45_BULLET_COLOR=$(V45_BULLET_COLOR) -DV45_SHIP_HIT_MODE=$(V45_SHIP_HIT_MODE) -DV45_START_ALIENS=$(V45_START_ALIENS) -DV45_STEP_MODE=$(V45_STEP_MODE) -DV45_SHIELD_LOAD_MODE=$(V45_SHIELD_LOAD_MODE) -DV45_EDGE_MODE=$(V45_EDGE_MODE) -DV45_SHIELD_PERF_MODE=$(V45_SHIELD_PERF_MODE) -DV45_CONTACT_MODE=$(V45_CONTACT_MODE) -DV45_BREAK_MODE=$(V45_BREAK_MODE) -DV45_CACHE_MODE=$(V45_CACHE_MODE) -DV45_RANGE_MODE=$(V45_RANGE_MODE) -DV45_SOLID_CACHE_MODE=$(V45_SOLID_CACHE_MODE) -DTEST_FREEZE=$(TEST_FREEZE) -DTEST_SHOT_X=$(TEST_SHOT_X) -DTEST_AUTO_FIRE=$(TEST_AUTO_FIRE) -DTEST_POSE=$(TEST_POSE) -o $@ main.c sndirq.asm sound_data.asm vpdiff_table.asm
clean:
	rm -f invaders_v45_solid_cache1_integration_count*.lnx *.o *.s
.PHONY: all clean
